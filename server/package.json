{
  "name": "@reader/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.mjs --external:pdfjs-dist --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node --no-warnings=ExperimentalWarning dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@reader/shared": "*",
    "hono": "^4.9.0",
    "pdfjs-dist": "^5.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
